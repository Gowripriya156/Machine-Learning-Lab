#import
import numpy as np
import pandas as pd
from sklearn.linear_model import LinearRegression
from sklearn.preprocessing import PolynomialFeatures
from sklearn.metrics import mean_squared_error,r2_score
import matplotlib.pyplot as plt
#fetch data
data_url= "auto-mpg.csv"
df= pd.read_csv(data_url)
df_clean = df[['displacement','mpg']].dropna
x= df[['displacement']].values.astype(float).reshape(-1,1)
y= df[['mpg']].values.astype(float).reshape(-1,1)
max_deg=15
degree= [x for x in range(1,max_deg+1)]
x_plot= np.linspace(x.min(),x.max(),500).reshape(-1,1)
#plt.figure(figsize=(10,6))
colors=['red','blue','cyan','green','orange','purple','brown','pink','magenta','olive','black','navy','gold','lime','teal']
print("_ "*5,"Performance metrics","_ "*5)
print("Degree\tMSE\tR^2")
for deg in degree:
  if deg==1:
    model=LinearRegression()
    model.fit(x,y)
    y_pred=model.predict(x)
    y_plot=model.predict(x_plot)

  else:
    poly= PolynomialFeatures(degree=deg)
    x_poly = poly.fit_transform(x)
    x_plot_poly=poly.transform(x_plot)
    model=LinearRegression()
    model.fit(x_poly,y)
    y_pred=model.predict(x_poly)
    y_plot=model.predict(x_plot_poly)
  #mse and r2
  mse=mean_squared_error(y,y_pred)
  r2=r2_score(y,y_pred)
  print(f"{deg}\t{mse}\t\t{r2}")
  plt.plot(x_plot,y_plot,color=colors[deg-1],label=f"Degree{deg}")
#draw graph
plt.xlabel("Engine displacement")
plt.ylabel("MPG")
plt.title("Linear vs Polynomial")
#plt.scatter(x,y)
plt.scatter(x,y,color='grey',s=5)
plt.show()


