import pandas as pd
import numpy as np
from sklearn.datasets import fetch_openml
from sklearn.model_selection import train_test_split
from sklearn.preprocessing import StandardScaler,PolynomialFeatures
from sklearn.linear_model import LinearRegression
from sklearn.metrics import mean_squared_error
import matplotlib.pyplot as plt

data=fetch_openml(name='boston',version=1,as_frame=True)
x=data.data.select_dtypes(include=np.number)
y=data.target.astype(float)

x=x[["RM"]]

x_train,x_test,y_train,y_test= train_test_split(x,y,test_size=0.2,random_state=42)

scaler=StandardScaler()
x_train=scaler.fit_transform(x_train)
x_test=scaler.transform(x_test)
deg=[1,2,3,4,5]
terr=[]
perr=[]
for d in range(1,6):
  poly=PolynomialFeatures(degree=d)
  x_train_poly=poly.fit_transform(x_train)
  x_test_poly=poly.transform(x_test)

  m=LinearRegression()
  m.fit(x_train_poly,y_train)

  y_pred=m.predict(x_test_poly)
  y_train_pred=m.predict(x_train_poly)

  mse_train=mean_squared_error(y_train,y_train_pred)
  mse_test=mean_squared_error(y_test,y_pred)

  print("\nDegree:",d)
  print("MSE Train:",mse_train)
  print("MSE Test:",mse_test)
  terr.append(mse_train)
  perr.append(mse_test)

plt.plot(deg,terr,marker='o',label='Train')
plt.plot(deg,perr,marker='o',label='Test')
plt.xlabel('Degree')
plt.ylabel('MSE')
plt.legend()
plt.grid()
plt.show()



